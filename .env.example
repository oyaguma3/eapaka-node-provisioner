# eapaka-node-provisioner の設定。このファイルを .env にコピーして書き換え、パーミッションを 600 にする。

# ---- 構成 ----

# 下流と同じホストで動かす場合は、共有ネットワークに参加する設定を重ねる。
#   本PoCが同一ホスト:            compose.eapaka-prov.yaml を加える
#   aka-only-server が同一ホスト: compose.aka-av.yaml を加える
# 別のホストの下流には VPN のアドレスで接続する（重ねない）。
COMPOSE_FILE=compose.yaml:compose.eapaka-prov.yaml:compose.aka-av.yaml
# 同一ホストの本PoCが作る共有ネットワークの名前（本PoC側の .env の PROVISIONING_SHARED_NETWORK と同じにする）。
PROVISIONING_SHARED_NETWORK=eapaka-prov
# 同一ホストの aka-only-server が作る共有ネットワークの名前（aka-only-server 側の .env の AKA_SHARED_NETWORK と同じにする）。
AKA_SHARED_NETWORK=aka-av
# provisioner が作る、同一ホストの管理クライアント（BFF など）向けの共有ネットワークの名前。
PROVISIONER_SHARED_NETWORK=eapaka-provisioner

# ---- 必須 ----

# provisioner 専用の Valkey のパスワード（下流の Valkey のパスワードとは別のもの）。
PROVISIONER_VALKEY_PASSWORD=change-me

# 管理クライアント（BFF など）。「識別名=クライアント証明書の SHA-256 フィンガープリント」をカンマ区切りで書く。
# 識別名は監査ログの mgmtClient になる（英数字と . _ - の 64 文字まで）。1 つもなければ起動しない。
PROVISIONER_ADMIN_CLIENTS=

# ---- 下流 ----

# 本PoCの Provisioning API。同一ホストなら既定のままでよい。
# 別ホストの場合は、provisioning-api のサーバー証明書の SAN に入っている名前か IP アドレスで指定する。
PROVISIONER_PROV_URL=https://provisioning-api:9444/admin/v1

# aka-only-server の管理API。空なら aka-only-server を扱わない（すべての加入者の鍵を本PoCに置く）。
# 同一ホストなら https://aka-only-server:9443/admin/v1。
PROVISIONER_AKA_URL=
# 本PoCの vector-gateway が aka-only-server に登録されている AVクライアントの ID（aka 版 GUI の AVクライアントの一覧で確かめる）。
# PROVISIONER_AKA_URL を設定する場合は必須。
PROVISIONER_AKA_AV_CLIENT_ID=

# PLMN マップ。本PoC側の .env の VECTOR_GATEWAY_PLMN_MAP と同じ値にする（例: 44010:01）。
# 01 に当たる PLMN の加入者の鍵を aka-only-server に、それ以外を本PoCに置く。
# 本PoCの vector-gateway を passthrough モード（VECTOR_GATEWAY_MODE=passthrough）で動かしている場合は空にする。
PROVISIONER_PLMN_MAP=

# 下流のクライアント証明書の秘密鍵を certs/client.pem とは別のファイルにした場合だけ、コンテナ内のパスを指定する。
PROVISIONER_CLIENT_KEY=
# 下流の 1 回の呼び出しの上限時間。
PROVISIONER_DOWNSTREAM_TIMEOUT=5s

# ---- provisioner の API ----

# 公開するホスト側のアドレスとポート。VPN 側のアドレス（Tailscale なら 100.x.y.z）かループバックに限定する。
PROVISIONER_PUBLISH=127.0.0.1:9446

# 自己署名のサーバー証明書を初回起動時に自動生成するとき、SAN に入れるホスト名と IP アドレス。
# 管理クライアントが接続に使う名前や IP アドレスをカンマ区切りで指定する（同一ホストの BFF は eapaka-provisioner）。
# 生成済みの証明書には反映されない。
PROVISIONER_TLS_HOSTS=localhost,127.0.0.1,eapaka-provisioner

# 持ち込みの証明書を使う場合は、certs/ に置いてコンテナ内のパス（/certs/...）を指定する。
# 空なら自己署名（/data/tls/ に自動生成）を使う。
PROVISIONER_TLS_CERT=
PROVISIONER_TLS_KEY=

# ---- その他 ----

PROVISIONER_LOG_LEVEL=info
PROVISIONER_AUDIT_MAX=10000
